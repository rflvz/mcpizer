{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcpizer.dev/schema/policy/v1.json",
  "title": "Artefacto declarativo de mcpizer",
  "description": "Política y enganche con la periferia. Solo referencias: ningún secreto vive en este fichero.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "capabilities", "accounts", "principals", "grants"],
  "properties": {
    "version": { "const": 1 },

    "capabilities": {
      "description": "El vocabulario estable. Es lo único que las concesiones pueden nombrar.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/capabilityId" },
          "description": { "type": "string" }
        }
      }
    },

    "upstreams": {
      "description": "El único punto que conoce nombres reales de tool. Absorbe los renombrados.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "transport", "tools"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "transport": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "command"],
                "properties": {
                  "kind": { "const": "mcp-stdio" },
                  "command": { "type": "string", "minLength": 1 },
                  "args": { "type": "array", "items": { "type": "string" } }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "url"],
                "properties": {
                  "kind": { "const": "mcp-http" },
                  "url": { "type": "string", "format": "uri" }
                }
              }
            ]
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "capability"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "capability": { "$ref": "#/$defs/capabilityId" }
              }
            }
          }
        }
      }
    },

    "accounts": {
      "description": "La segunda identidad. Solo asas opacas y referencias a secretos.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "secret"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "disabled": { "type": "boolean" },
          "secret": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref"],
            "properties": {
              "ref": { "$ref": "#/$defs/secretRef" }
            }
          }
        }
      }
    },

    "principals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuers"],
      "properties": {
        "issuers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "kind": { "enum": ["oidc", "static-key", "mtls"] },
              "discovery": { "type": "string", "format": "uri" },
              "audience": { "type": "string" },
              "subject": {
                "description": "A quién identifica una clave estática. Un token trae sujeto; una clave, no.",
                "type": "string",
                "minLength": 1
              },
              "secret": {
                "description": "Dónde está la clave que se compara. Nunca la clave.",
                "type": "object",
                "additionalProperties": false,
                "required": ["ref"],
                "properties": {
                  "ref": { "$ref": "#/$defs/secretRef" }
                }
              },
              "attributes": {
                "description": "Lo no declarado aquí se descarta: la política no puede discriminar sobre ello.",
                "type": "object",
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },

    "grants": {
      "description": "Solo concesiones. No hay reglas de denegación; el resultado no depende del orden.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "capabilities", "using"],
        "properties": {
          "to": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issuer"],
            "properties": {
              "issuer": { "$ref": "#/$defs/identifier" },
              "attributes": {
                "type": "object",
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            }
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/capabilityId" }
          },
          "using": { "$ref": "#/$defs/identifier" },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["calls", "per"],
            "properties": {
              "calls": { "type": "integer", "minimum": 0 },
              "per": { "type": "string", "pattern": "^[1-9][0-9]*[smhd]$" }
            }
          }
        }
      }
    }
  },

  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "secretRef": {
      "description": "Referencia resoluble en la periferia. Nunca el material en sí.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.-]*://.+"
    },
    "capabilityId": {
      "description": "Identificador estable. Renombrar una tool upstream nunca lo cambia.",
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    }
  }
}
